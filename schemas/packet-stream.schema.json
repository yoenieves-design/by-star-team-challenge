{
  "$id": "packet-stream",
  "type": "array",
  "minItems": 1,
  "maxItems": 10000,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "id", "sequence", "deviceId", "subject", "measuredAtS", "receivedAtS", "origin", "measurements"],
    "properties": {
      "schemaVersion": { "const": 1 },
      "id": { "type": "string", "minLength": 1, "maxLength": 100 },
      "sequence": { "type": "integer", "minimum": 1 },
      "deviceId": { "type": "string", "minLength": 1 },
      "subject": { "$ref": "#/$defs/subject" },
      "measuredAtS": { "type": "integer", "minimum": 0 },
      "receivedAtS": { "type": "integer", "minimum": 0 },
      "origin": { "const": "synthetic" },
      "measurements": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "value", "unit", "quality"],
          "properties": {
            "metric": { "$ref": "#/$defs/metric" },
            "value": { "type": ["number", "null"] },
            "unit": { "enum": ["bpm", "°C", "counts/min", "%", "kPa"] },
            "quality": { "enum": ["good", "degraded", "unavailable"] }
          },
          "if": { "properties": { "quality": { "const": "unavailable" } } },
          "then": { "properties": { "value": { "type": "null" } } },
          "else": { "properties": { "value": { "type": "number" } } }
        }
      }
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": { "type": { "enum": ["crew", "zone"] }, "id": { "type": "string", "minLength": 1 } }
    },
    "metric": { "enum": ["heart_rate", "skin_temperature", "activity", "oxygen", "carbon_dioxide", "pressure"] }
  }
}
