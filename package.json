{
  "name": "by-star-mission-health",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "schemas": "node scripts/generate-validators.mjs",
    "fixtures": "node scripts/create-telemetry.mjs",
    "typecheck": "npm run schemas && tsc --noEmit",
    "build": "npm run schemas && vite build && node scripts/write-preview.mjs",
    "build:pages": "npm run typecheck && npm test && npm run build",
    "test": "npm run schemas && node --test \"tests/unit/*.test.ts\"",
    "test:browser": "playwright test",
    "dev": "npm run schemas && vite",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "ajv": "^8.20.0",
    "lit-html": "^3.3.3",
    "typescript": "5.9",
    "vite": "^7.3.8"
  }
}
